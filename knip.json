{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": [
    "src/types/database.types.ts",
    "public/**"
  ],
  "ignoreExportsUsedInFile": true,
  "ignoreDependencies": ["server-only"],
  "ignoreBinaries": ["supabase"],
  "next": {
    "entry": [
      "next.config.{js,ts,cjs,mjs}",
      "src/proxy.ts",
      "src/app/**/{page,layout,loading,error,not-found,global-error,template,default,route,sitemap,robots,manifest,opengraph-image,icon,apple-icon}.{js,ts,jsx,tsx}",
      "src/app/**/actions.ts",
      "src/app/**/*[aA]ctions.ts",
      "src/app/**/_shared-actions.ts"
    ]
  },
  "playwright": {
    "config": ["playwright.config.ts"],
    "entry": ["e2e/**/*.{test,spec}.ts", "e2e/**/*.setup.ts"]
  }
}
