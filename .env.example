# NMM — yerel geliştirme (.env.local olarak kopyalayın)
# Vercel prod/preview: aynı anahtarlar Dashboard → Environment Variables'da.

# ── Supabase (zorunlu) ──
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── AI (zorunlu) ──
GEMINI_API_KEY=your-gemini-key

# ── Uygulama URL (e-posta, ödeme callback) ──
NMM_APP_URL=http://localhost:3000

# ── E-posta (Resend) ──
RESEND_API_KEY=re_xxx
RESEND_FROM_EMAIL=NMM <noreply@yourdomain.com>

# ── Cron (Vercel cron route'ları) ──
CRON_SECRET=generate-a-long-random-string

# ── Shopier ödeme (prod'da zorunlu) ──
# SHOPIER_PRODUCTS doluysa storefront otomatik açılır (SHOPIER_STOREFRONT_ENABLED=true zorunlu değil).
# SHOPIER_STOREFRONT_ENABLED=false ile bilinçli kapatma mümkün.
SHOPIER_API_KEY=
SHOPIER_API_SECRET=
SHOPIER_WEBHOOK_SECRET=
SHOPIER_REFUND_WEBHOOK_SECRET=
SHOPIER_PRODUCTS={"basic_monthly":{"url":"https://www.shopier.com/networkmarketingmaster/47695583","productId":"47695583"},"plus_monthly":{"url":"https://www.shopier.com/...","productId":"..."},"pro_monthly":{"url":"https://www.shopier.com/...","productId":"..."}}

# ── E2E (yalnızca npm run test:e2e — Vercel'e EKLEMEYİN) ──
PLAYWRIGHT_TEST_EMAIL=
PLAYWRIGHT_TEST_PASSWORD=
# Opsiyonel: deneme süresi bitmiş hesap — e2e/expired-trial-ekip.spec.ts
PLAYWRIGHT_TRIAL_EXPIRED_EMAIL=
PLAYWRIGHT_TRIAL_EXPIRED_PASSWORD=
# Pipeline NMM davet kaydı (?ref=workspace_invite_code&aday=candidate_id) — opsiyonel
PLAYWRIGHT_INVITE_REF=
PLAYWRIGHT_INVITE_ADAY=

# ── Supabase CLI drift kontrolü (isteğe bağlı, yerel) ──
# SUPABASE_ACCESS_TOKEN=
# SUPABASE_PROJECT_REF=
